        {
          "if_true": {
            "type": "minecraft:not",
            "predicate": {
              "type": "minecraft:matching_block_tag",
              "tag": "minecraft:cannot_replace_below_tree_trunk"
            }
          },
          "then": {
            "type": "minecraft:simple_state_provider",
            "state": {
              "Name": "minecraft:dirt"
            }
          }
        }
      ]
    },
    "decorators": [
      {
        "type": "twilightforest:tree_roots",
        "additional_random_strands": 1,
        "base_strand_count": 3,
        "ground_roots_provider": {
          "type": "minecraft:weighted_state_provider",
          "entries": [
            {
              "data": {
                "Name": "twilightforest:root"
              },
              "weight": 6
            },
            {
              "data": {
                "Name": "twilightforest:liveroot_block"
              },
              "weight": 1
            }
          ]
        },
        "rootPenetrability": 1,
        "root_length": 5,
        "y_offset": 0
      },
      {
        "type": "minecraft:leave_vine",
        "probability": 0.125
      }
    ],
    "foliage_placer": {
      "type": "minecraft:blob_foliage_placer",
      "height": 3,
      "offset": 0,
      "radius": 2
    },
    "foliage_provider": {
      "type": "minecraft:simple_state_provider",
      "state": {
        "Name": "twilightforest:twilight_oak_leaves",
        "Properties": {
          "distance": "7",
          "persistent": "false",
          "waterlogged": "false"
        }
      }
    },
    "ignore_vines": false,
    "minimum_size": {
      "type": "minecraft:two_layers_feature_size",
      "limit": 1,
      "lower_size": 0,
      "upper_size": 1
    },
    "trunk_placer": {
      "type": "minecraft:straight_trunk_placer",
      "base_height": 4,
      "height_rand_a": 2,
      "height_rand_b": 0
    },
    "trunk_provider": {
      "type": "minecraft:simple_state_provider",
      "state": {
        "Name": "twilightforest:twilight_oak_log",
        "Properties": {
          "axis": "y"
        }
      }
