  "commands.tffeature.structure.spawn_info": "%s, წონა %s",
  "commands.tffeature.structure.spawn_list": "არეალში გაჩენის სია: ",
  "config.twilightforest.aurora_biomes": "ციალის ბიომის შეიდერები",
  "config.twilightforest.aurora_biomes.tooltip": "წყვეტს რომელ ბიომებში გამოიყენება ციალის შეიდერები. ეფექტის გასათიშად დატოვეთ სია ცარელა.",
  "config.twilightforest.disable_uncrafting": "დაშლის გათიშვა",
  "config.twilightforest.disable_uncrafting.tooltip": "თიშავს დამშლელის დაშლის ფუნქციას. რეკომენდებულია მხოლოდ უკიდურეს შემთხვევაში, თუ ძალიან ბევრი რამეა შესაცვლელი მის ქცევაში (ან უბრალოდ ზარმაცი ხარ, არ განგსჯი).\nგაითვალისწინე, რომ სპეციალური დაშლის რეცეპტები არ ითიშება, რადგან მოდი მათ სხვა მიზნებისთვისაც იყენებს.",
  "config.twilightforest.disable_uncrafting_table": "დამშლელის გათიშვა",
  "config.twilightforest.disable_uncrafting_table.tooltip": "თიშავს დამშლელის ნებისმიერ გამოყენებას, ასევე აღარ შეგხვდებათ ნადავლში ან შექმნისას.\nგაითვალისწინეთ, რომ დამშლელს დაშლის გარდა სხვა, ბევრი გამოყენებაც აქვს – ამაზე მეტი შეგიძლიათ წაიკითხოთ აქ: http://benimatic.com/tfwiki/index.php?title=Uncrafting_Table\nმოდში არსებობს სპეციალურად დაშლისთვის განკუთვნილი უნიკალური რეცეპტები, ამიტომ რეკომენდებულია დამშლელის ჩართულად დატოვება, თუმცა ეს პარამეტრი რჩება მათთვის, ვისაც საერთოდ არ სურს დამშლელის ფუნქციონირება.\nთუ უბრალოდ გსურთ, რომ ჩვეულებრივი დამზადების რეცეპტების შექცევა აიცილო, სჯობს „disableUncrafting“ პარამეტრის გამოყენება.",
  "config.twilightforest.ingredient_switching.tooltip": "ჩართვისას, დამშლელი აღარ შეგაცვლევინებს ინგრედიენტებს, თუ რეცეპტი იყენებს შექმნის ტეგს.\nვერც ერთი რეცეპტი ვერ იმოქმედებს!\nთუ გსურთ გარკვეული რეცეპტების გამოჩენის გამორთვა, გამოიყენეთ ტეგი: „twilightforest:banned_uncrafting_ingredients“.",
  "config.twilightforest.shapeless_uncrafting": "უფორმო დაშლა",
  "config.twilightforest.shapeless_uncrafting.tooltip": "ჩართვისას, დამშლელი შეძლებს უფორმო რეცეპტების დაშლასაც.\nდამშლელი მოსაზრებული იყო ფორმიანი რეცეპტებისთვის, მაგრამ პარამეტრი შენარჩუნებულია ხალხისთვის, რომლებსაც სურთ ფუნქციის შენარჩუნება.",
  "config.twilightforest.uncrafting": "დამშლელი",
  "config.twilightforest.uncrafting.tooltip": "დამშლელთან დაკავშირებული პარამეტრები.",
  "config.twilightforest.uncrafting_mod_id_flip": "მოდის ID-ების შავი სია",
  "config.twilightforest.uncrafting_mod_id_flip.tooltip": "ჩართვისას, ზედა პარამეტრს შავი სიიდან თეთრ სიად გადააკეთებს.",
  "config.twilightforest.uncrafting_mod_ids": "მოდის ID-ების გათიშვა",
  "config.twilightforest.uncrafting_mod_ids.tooltip": "აქ შეგიძლიათ აირჩიოთ სასურველი ნივთები გარკვეული მოდებიდან, რომლებიც არ გსურთ რომ დაშლადი იყოს.\nშეიყვანეთ მოდის მართებული ID, რომ გათიშოს მისი ყოველი დაშლის რეცეპტი.\nმაგალითად: „twilightforest“ გათიშავს ყოველ დაშლის რეცეპტს ამ მოდიდან.",
  "config.twilightforest.uncrafting_recipes": "გათიშული რეცეპტები",
  "config.twilightforest.uncrafting_recipes.tooltip": "თუ გსურთ არა ყველაფრის დაშლის გათიშვა, არამედ კონკრეტული რეცეპტების – თქვენ გეხებათ.\nრეცეპტის დასამატებლად დაამატეთ მოდის ID და შემდგომ რეცეპტის სახელი. შეგიძლიათ დაგაამოწმოთ ისეთ რაღაცებში, როგორიცაა JEI.\nმაგალითად: „twilightforest:firefly_particle_spawner“ გათიშავს ნაწილაკების გამჩენის დაშლას ციცინათელებიან ქილად, ციცინათელად და ყაყაჩოდ.\nთუ ნივთს აქვს რამოდენიმე შექმნის რეცეპტი და გსურთ ყოველის გათიშვა – დაამატეთ ნივთი „twilightforest:banned_uncraftables“ ნივთთა ტეგში.\nთუ გაქვთ პრობლემური ინგრედიენტი, მაგალითად დაავადებული კოშკხე – დაამატეთ „twilightforest:banned_uncrafting_ingredients“ ნივთთა ტეგში.",
  "config.twilightforest.uncrafting_recipes_flip": "რეცეპტთა შავი სია",
  "config.twilightforest.uncrafting_recipes_flip.tooltip": "ჩართვისას, ზედა რეცეპტთა სიას შავიდან თეთრად გადააკეთებს.",
